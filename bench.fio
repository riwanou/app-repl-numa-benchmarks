[global]
group_reporting
ioengine=mmap
size=${SIZE}
thread=1
filename=${FIO_DIR}/fio_readwrite
time_based
runtime=${RUNTIME}
share_mmap=1
norandommap=1
ramp_time=35
# fio's cache invalidation staggers the thread starts
invalidate=0

[writers]
rw=randwrite
random_distribution=${WDISTRIB}
numjobs=${WRITEJOBS}

[readers]
rw=randread
random_distribution=${DISTRIB}
numjobs=${READJOBS}

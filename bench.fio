[global]
group_reporting
ioengine=mmap
size=${SIZE}
thread=1
directory=/tmp
filename=/tmp/fio_readwrite
time_based
runtime=${RUNTIME}
share_mmap=1
repl=1
norandommap=1
ramp_time=20

[writers]
rw=randwrite
random_distribution=${DISTRIB}
numjobs=${WRITEJOBS}

[readers]
rw=randread
random_distribution=${DISTRIB}
numjobs=${READJOBS}
